    <!-- Equivalent Classes based on year (similar to art periods) -->
    <owl:Class rdf:about="http://www.semanticweb.org/veron/ontologies/2026/9/stavebna-firma#ProjectPeriod"/>

    <owl:Class rdf:about="http://www.semanticweb.org/veron/ontologies/2026/9/stavebna-firma#ModernProject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/veron/ontologies/2026/9/stavebna-firma#year"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
